---
const today = new Date();
---

<footer>
	<span>&copy; {today.getFullYear()} Jack Belluche</span>
	<nav aria-label="Footer navigation">
		<a href="/rss.xml">RSS</a>
		<a href="https://github.com/jbelluche" target="_blank" rel="noreferrer">GitHub</a>
	</nav>
</footer>

<style>
	footer {
		display: flex;
		justify-content: space-between;
		max-width: 960px;
		margin: 3rem auto 0;
		padding: 2rem 1.5rem 3rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.9rem;
	}
	nav {
		display: flex;
		gap: 1rem;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	@media (max-width: 520px) {
		footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
