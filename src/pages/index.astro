---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="intro">
				<p class="eyebrow">Jack Belluche</p>
				<h1>Notes on things<br />worth thinking about.</h1>
				<p class="lede">
					Essays, observations, and occasional deep dives into software, ideas, and whatever else
					seems interesting.
				</p>
			</section>

			<section class="recent">
				<div class="section-heading">
					<h2>Recent writing</h2>
					<a href="/blog">View all</a>
				</div>
				{
					posts.length > 0 ? (
						<ul class="post-list">
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span>
											<strong>{post.data.title}</strong>
											<small>{post.data.description}</small>
										</span>
										<FormattedDate date={post.data.pubDate} />
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="empty-state">The first article is on the way.</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 100%;
		max-width: 960px;
		padding: 6rem 1.5rem 2rem;
	}
	.intro {
		max-width: 800px;
		padding-bottom: 6rem;
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	h1 {
		margin-bottom: 1.5rem;
		font-size: clamp(3rem, 9vw, 6.6rem);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 0.95;
	}
	.lede {
		max-width: 640px;
		margin: 0;
		color: var(--muted);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		line-height: 1.5;
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--ink);
	}
	.section-heading h2 {
		margin: 0;
		font-family: var(--font-atkinson);
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.section-heading a {
		font-size: 0.9rem;
	}
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li {
		border-bottom: 1px solid var(--border);
	}
	.post-list a {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.4rem 0;
		color: var(--ink);
		text-decoration: none;
	}
	.post-list strong,
	.post-list small {
		display: block;
	}
	.post-list strong {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.3rem;
	}
	.post-list small,
	.post-list time,
	.empty-state {
		color: var(--muted);
		font-size: 0.9rem;
	}
	.empty-state {
		margin: 0;
		padding: 2rem 0;
		border-bottom: 1px solid var(--border);
	}
	@media (max-width: 640px) {
		.home {
			padding-top: 4rem;
		}
		.intro {
			padding-bottom: 4rem;
		}
		.post-list a {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>
