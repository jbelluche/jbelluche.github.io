---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			<p class="intro">Essays, notes, and interesting things I’ve learned along the way.</p>
			<section>
				{
					posts.length > 0 ? (
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<h2 class="title">{post.data.title}</h2>
										<p class="description">{post.data.description}</p>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="empty-state">No articles yet. Check back soon.</p>
					)
				}
				<p class="rss"><a href="/rss.xml">Subscribe via RSS</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 720px;
		padding-top: 6rem;
	}
	h1 {
		margin-bottom: 0.5rem;
	}
	.intro {
		margin-bottom: 3rem;
		color: var(--muted);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul li {
		border-top: 1px solid var(--border);
	}
	ul li a {
		display: block;
		padding: 1.5rem 0;
		color: var(--ink);
		text-decoration: none;
	}
	.title {
		margin: 0 0 0.25rem;
		font-size: 1.7rem;
	}
	.description,
	.date,
	.empty-state {
		margin: 0;
		color: var(--muted);
	}
	.description {
		margin-bottom: 0.5rem;
	}
	ul li a:hover .title {
		color: var(--accent);
	}
	.empty-state {
		padding: 1.5rem 0;
		border-top: 1px solid var(--border);
	}
	.rss {
		margin-top: 2rem;
		font-size: 0.9rem;
	}
</style>
